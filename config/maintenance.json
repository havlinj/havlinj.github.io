/*
 * Maintenance mode — use exactly one of these shapes (do not mix fields).
 *
 * 1) Site open (default):
 *    { "mode": "off" }
 *
 * 2) Whole site unavailable (home shows the Whoops panel, same photo as
 *    route maintenance; nav labels are omitted but the nav still reserves
 *    its usual line; the footer has no Home link; every other URL redirects to /):
 *    { "mode": "global" }
 *
 * 3) Whole site under reconstruction (home shows a content panel with a
 *    background photo; nav labels and the footer are omitted, but the nav
 *    still reserves its usual line of space; every other URL redirects to /):
 *    { "mode": "reconstruction" }
 *
 * 4) Selected routes only (Whoops + content panel notice; header/footer stay):
 *    {
 *      "mode": "routes",
 *      "routes": [
 *        { "path": "/writing", "match": "prefix" },
 *        { "path": "/contact/form", "match": "exact" }
 *      ]
 *    }
 *
 * Notes:
 * - `match`: "prefix" also covers nested paths (/contact → /contact/form);
 *   "exact" locks a single URL.
 * - Invalid or mixed shapes fail `astro build`.
 * - Comments in this file are allowed (JSONC-style).
 */
{
  "mode": "global"
}
