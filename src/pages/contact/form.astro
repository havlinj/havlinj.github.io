---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import RouteMaintenancePage from '../../components/RouteMaintenancePage.astro';
import { gateNonHomeMaintenance } from '../../utils/maintenance';
import '../../styles/pages/contact.css';

const { redirectHome, decision: maintenance } = gateNonHomeMaintenance(
  Astro.url.pathname,
);
if (redirectHome) {
  return Astro.redirect('/');
}

const title = 'Contact form — Jan Havlín';
---

{
  maintenance.kind === 'route' ? (
    <RouteMaintenancePage decision={maintenance} activeSection="contact" />
  ) : (
    <Layout title={title} activeSection="contact">
      <Fragment slot="head">
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      </Fragment>
      <article class="contact has-page-title-rule">
        <h1 class="page-title">Contact</h1>
        <ContactForm />
      </article>
    </Layout>
  )
}
