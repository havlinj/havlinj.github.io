---
import Layout from '../layouts/Layout.astro';
import ContactPageBody from '../components/ContactPageBody.astro';
import RouteMaintenanceNotice from '../components/RouteMaintenanceNotice.astro';
import { resolveMaintenance } from '../utils/maintenance';

const maintenance = resolveMaintenance(Astro.url.pathname);

if (maintenance.kind === 'global') {
  return Astro.redirect('/');
}

const title = 'Contact — Jan Havlín';
---

{
  maintenance.kind === 'route' ? (
    <Layout title="Whoops" activeSection="contact">
      <RouteMaintenanceNotice decision={maintenance} />
    </Layout>
  ) : (
    <Layout title={title} activeSection="contact">
      <ContactPageBody />
    </Layout>
  )
}
