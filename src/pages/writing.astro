---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ResponsiveDichromPicture from '../components/ResponsiveDichromPicture.astro';
import WritingPostButton from '../components/WritingPostButton.astro';
import { buildDichromResponsive } from '../constants/dichrom-responsive';
import '../styles/pages/writing.css';
import {
  splitAndSortWritingPosts,
  type WritingCategoryGroup,
  type WritingPostLike,
} from '../utils/writing-posts';

const posts = await getCollection('blog');
const { technical, conceptual } = splitAndSortWritingPosts(posts);

const writingBg = buildDichromResponsive(
  '/assets/pages/writing/weichao-deng-k0JQkPtfN3s-unsplash_dichrom',
);

type WritingSectionView = {
  headingId: string;
  heading: string;
  hasPosts: boolean;
  featuredPosts: WritingPostLike[];
  regularPosts: WritingPostLike[];
  featuredLabel: string;
  regularLabel: string;
};

function buildWritingSectionView(
  key: string,
  heading: string,
  group: WritingCategoryGroup<WritingPostLike>,
): WritingSectionView {
  return {
    headingId: `writing-section-heading-${key}`,
    heading,
    hasPosts: group.featuredPosts.length + group.regularPosts.length > 0,
    featuredPosts: group.featuredPosts,
    regularPosts: group.regularPosts,
    featuredLabel: `Featured ${key} articles`,
    regularLabel: `${heading} articles`,
  };
}

const sections: WritingSectionView[] = [
  buildWritingSectionView('technical', 'Technical Deep Dives', technical),
  buildWritingSectionView('conceptual', 'Conceptual Reflections', conceptual),
];
---

<Layout title="Writing" activeSection="writing">
  <article class="writing-page">
    <h1 class="page-title">Writing</h1>
    <div class="page-buttons-zone">
      <div class="page-buttons-panel">
        <div class="page-buttons-panel__media" aria-hidden="true">
          <ResponsiveDichromPicture
            sources={writingBg}
            width={2736}
            height={2204}
            fetchpriority="high"
          />
        </div>
        <div class="writing-groups writing-groups--pending" aria-busy="true">
          {
            sections.map((section) => (
              <section
                class="writing-section"
                aria-labelledby={section.headingId}
              >
                <h2 id={section.headingId} class="writing-section__heading">
                  {section.heading}
                </h2>
                {section.featuredPosts.length > 0 && (
                  <ul
                    class="post-list page-buttons"
                    aria-label={section.featuredLabel}
                  >
                    {section.featuredPosts.map((post) => (
                      <WritingPostButton post={post} />
                    ))}
                  </ul>
                )}
                {section.hasPosts && (
                  <ul
                    class="post-list page-buttons"
                    aria-label={section.regularLabel}
                  >
                    {section.regularPosts.map((post) => (
                      <WritingPostButton post={post} />
                    ))}
                  </ul>
                )}
                {!section.hasPosts && (
                  <ul
                    class="post-list page-buttons"
                    aria-label={section.regularLabel}
                  >
                    <li>
                      <div class="page-button page-button--placeholder">
                        <span class="page-button__bg" aria-hidden="true" />
                        <span class="page-button__overlay" aria-hidden="true" />
                        <span class="page-button__inner">
                          <span class="page-button__text page-button__text--placeholder">
                            Coming up&hellip;
                          </span>
                        </span>
                      </div>
                    </li>
                  </ul>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </article>
  <noscript>
    <style>
      .writing-page .writing-groups.writing-groups--pending {
        opacity: 1 !important;
        pointer-events: auto !important;
      }
    </style>
  </noscript>
  <script is:inline>
    (() => {
      const SELECTORS = {
        writingArticle: 'article.writing-page',
        writingGroups: '.writing-page .writing-groups',
        sectionHeading: '.writing-page .writing-section__heading',
        cqContainer: 'main.content',
      };
      const HEADING_WIDTH_VAR = '--writing-section-heading-width';

      const writingGroups = document.querySelector(SELECTORS.writingGroups);

      /*
       * Section heading rectangles share one width: the widest heading's own
       * (text + padding) size, written to `--writing-section-heading-width`
       * on `.writing-groups` so every `.writing-section__heading` (see
       * writing.css) inherits it via `var()`. Heading font-size is `cqi`-based
       * off `main.content`, so re-measure whenever that container resizes —
       * clearing the previous value first so each heading reports its own
       * natural width rather than the last equalized one.
       */
      function equalizeWritingSectionHeadingWidths() {
        if (!(writingGroups instanceof HTMLElement)) return;
        const headings = Array.from(
          document.querySelectorAll(SELECTORS.sectionHeading),
        );
        if (headings.length === 0) return;
        writingGroups.style.removeProperty(HEADING_WIDTH_VAR);
        const widestPx = Math.max(
          ...headings.map((heading) => heading.getBoundingClientRect().width),
        );
        writingGroups.style.setProperty(HEADING_WIDTH_VAR, `${widestPx}px`);
      }

      let buttonsRevealed = false;
      function revealWritingButtons() {
        if (buttonsRevealed || !writingGroups) return;
        buttonsRevealed = true;
        equalizeWritingSectionHeadingWidths();
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            writingGroups.classList.remove('writing-groups--pending');
            writingGroups.classList.add('writing-groups--visible');
            writingGroups.removeAttribute('aria-busy');
          });
        });
      }

      const fontsReady = document.fonts?.ready ?? Promise.resolve();
      fontsReady.finally(() => revealWritingButtons());
      window.setTimeout(revealWritingButtons, 2500);

      const cqContainer = document.querySelector(SELECTORS.cqContainer);
      if (cqContainer instanceof HTMLElement && 'ResizeObserver' in window) {
        let widthSyncScheduled = false;
        const resizeObserver = new ResizeObserver(() => {
          if (!buttonsRevealed || widthSyncScheduled) return;
          widthSyncScheduled = true;
          requestAnimationFrame(() => {
            widthSyncScheduled = false;
            equalizeWritingSectionHeadingWidths();
          });
        });
        resizeObserver.observe(cqContainer);
      }
    })();
  </script>
</Layout>
