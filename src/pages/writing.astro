---
import Layout from '../layouts/Layout.astro';
import RouteMaintenancePage from '../components/RouteMaintenancePage.astro';
import WritingPageBody from '../components/WritingPageBody.astro';
import { gateNonHomeMaintenance } from '../utils/maintenance';

const { redirectHome, decision: maintenance } = gateNonHomeMaintenance(
  Astro.url.pathname,
);
if (redirectHome) {
  return Astro.redirect('/');
}
---

{
  maintenance.kind === 'route' ? (
    <RouteMaintenancePage decision={maintenance} activeSection="writing" />
  ) : (
    <Layout title="Writing" activeSection="writing">
      <WritingPageBody />
    </Layout>
  )
}
