---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProfilePageBody from '../components/ProfilePageBody.astro';
import RouteMaintenancePage from '../components/RouteMaintenancePage.astro';
import { gateNonHomeMaintenance } from '../utils/maintenance';
import typeFitUrl from '../scripts/profile-tile-type-fit.ts?url';

const { redirectHome, decision: maintenance } = gateNonHomeMaintenance(
  Astro.url.pathname,
);
if (redirectHome) {
  return Astro.redirect('/');
}

type ProfileContent = Awaited<ReturnType<typeof render>>['Content'];

let pageTitle = 'Whoops';
let Content: ProfileContent | null = null;

if (maintenance.kind !== 'route') {
  const page = await getEntry('pages', 'profile');
  if (!page) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  const rendered = await render(page);
  pageTitle = page.data.title;
  Content = rendered.Content;
}
---

{
  maintenance.kind === 'route' ? (
    <RouteMaintenancePage decision={maintenance} activeSection="profile" />
  ) : (
    <Layout title={pageTitle} activeSection="profile" profileStylesLast>
      <link slot="head" rel="modulepreload" href={typeFitUrl} />
      {Content && <ProfilePageBody pageTitle={pageTitle} Content={Content} />}
    </Layout>
  )
}
