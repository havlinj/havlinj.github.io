---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RouteMaintenanceNotice from '../components/RouteMaintenanceNotice.astro';
import { resolveMaintenance } from '../utils/maintenance';
import typeFitUrl from '../scripts/profile-tile-type-fit.ts?url';

const maintenance = resolveMaintenance(Astro.url.pathname);

if (maintenance.kind === 'global') {
  return Astro.redirect('/');
}

type ProfileContent = Awaited<ReturnType<typeof render>>['Content'];

let pageTitle = 'Whoops';
let Content: ProfileContent | null = null;

if (maintenance.kind !== 'route') {
  const page = await getEntry('pages', 'profile');
  if (!page) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  const rendered = await render(page);
  pageTitle = page.data.title;
  Content = rendered.Content;
}
---

{
  maintenance.kind === 'route' ? (
    <Layout title="Whoops" activeSection="profile">
      <RouteMaintenanceNotice decision={maintenance} />
    </Layout>
  ) : (
    <Layout title={pageTitle} activeSection="profile" profileStylesLast>
      <link slot="head" rel="modulepreload" href={typeFitUrl} />
      <article class="has-buttons-panel">
        <h1 class="page-title">{pageTitle}</h1>
        {Content && <Content />}
      </article>
      <script>
        import { initProfileLoadingVeil } from '../scripts/profile-loading-veil.ts';
        initProfileLoadingVeil();
      </script>
      <script>
        import '../scripts/profile-tile-type-fit.ts';
      </script>
    </Layout>
  )
}
