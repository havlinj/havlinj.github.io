---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import WhyContent from '../components/WhyContent.astro';
import RouteMaintenanceNotice from '../components/RouteMaintenanceNotice.astro';
import { resolveMaintenance } from '../utils/maintenance';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((page) => page.id.replace(/\.md$/, '') !== 'profile')
    .map((page) => ({
      params: { slug: page.id.replace(/\.md$/, '') },
      props: { page },
    }));
}

const { slug } = Astro.params;
const maintenance = resolveMaintenance(`/${slug}`);

if (maintenance.kind === 'global') {
  return Astro.redirect('/');
}

const PROFILE_SECTION_SLUGS = new Set([
  'profile',
  'why-this',
  'what-i-do',
  'foundations',
]);
const sectionBySlug: Record<string, string> = {
  contact: 'contact',
  credits: 'credits',
};
const activeSection = PROFILE_SECTION_SLUGS.has(slug)
  ? 'profile'
  : sectionBySlug[slug] || undefined;
const isWhy = slug === 'why-this';
/** Same 1px rule under H1 as Contact (special-typography.css --page-title-rule-gap) */
const hasPageTitleRule =
  slug === 'credits' || slug === 'what-i-do' || slug === 'foundations';

let pageTitle = 'Whoops';
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;

if (maintenance.kind !== 'route') {
  const page = await getEntry('pages', slug);
  if (!page) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  const rendered = await render(page);
  pageTitle = page.data.title;
  Content = rendered.Content;
}
---

{
  maintenance.kind === 'route' ? (
    <Layout title="Whoops" activeSection={activeSection}>
      <RouteMaintenanceNotice decision={maintenance} />
    </Layout>
  ) : (
    <Layout title={pageTitle} activeSection={activeSection}>
      <article
        class={[isWhy && 'why-page', hasPageTitleRule && 'has-page-title-rule']
          .filter(Boolean)
          .join(' ')}
      >
        <h1 class="page-title">{pageTitle}</h1>
        {isWhy ? <WhyContent /> : Content && <Content />}
      </article>
    </Layout>
  )
}
