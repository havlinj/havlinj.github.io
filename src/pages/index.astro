---
import Layout from '../layouts/Layout.astro';
import DichromPreloadLink from '../components/DichromPreloadLink.astro';
import GlobalMaintenanceNotice from '../components/GlobalMaintenanceNotice.astro';
import HomeHero from '../components/HomeHero.astro';
import { buildDichromResponsive } from '../constants/dichrom-responsive';
import { HERO_BG_STEM } from '../constants/hero-layout';
import { resolveMaintenance } from '../utils/maintenance';

const maintenance = resolveMaintenance(Astro.url.pathname);
const heroBg =
  maintenance.kind === 'global' ? null : buildDichromResponsive(HERO_BG_STEM);
---

{
  maintenance.kind === 'global' ? (
    <Layout title="Website under maintenance">
      <GlobalMaintenanceNotice />
    </Layout>
  ) : (
    <Layout title="Jan Havlín">
      <Fragment slot="head">
        {heroBg && <DichromPreloadLink sources={heroBg} />}
      </Fragment>
      {heroBg && <HomeHero sources={heroBg} />}
    </Layout>
  )
}
