---
import Layout from '../layouts/Layout.astro';
import GlobalMaintenanceNotice from '../components/GlobalMaintenanceNotice.astro';
import ReconstructionNotice from '../components/ReconstructionNotice.astro';
import HomeHero from '../components/HomeHero.astro';
import {
  buildDichromHeroResponsive,
  dichromCandidateSrcset,
} from '../constants/dichrom-responsive';
import { HERO_BG_STEM } from '../constants/hero-layout';
import { parseDichromCandidates } from '../utils/dichrom-tier-select';
import { selectHeroScannerCandidate } from '../utils/dichrom-hero-estimate';
import { resolveMaintenance } from '../utils/maintenance';

const maintenance = resolveMaintenance(Astro.url.pathname);
const siteShutdown =
  maintenance.kind === 'global' || maintenance.kind === 'reconstruction';
const heroBg = siteShutdown ? null : buildDichromHeroResponsive(HERO_BG_STEM);
const heroScannerCandidate = heroBg
  ? selectHeroScannerCandidate(
      parseDichromCandidates(dichromCandidateSrcset(heroBg)),
    )
  : null;
const heroInitialHref =
  heroScannerCandidate?.href ?? heroBg?.w1080.href ?? null;
---

{
  maintenance.kind === 'reconstruction' ? (
    <Layout title="Website under reconstruction" showFooter={false}>
      <ReconstructionNotice />
    </Layout>
  ) : maintenance.kind === 'global' ? (
    <Layout title="Whoops" showFooterHome={false}>
      <GlobalMaintenanceNotice />
    </Layout>
  ) : (
    <Layout title="Jan Havlín">
      {heroInitialHref && (
        <link
          slot="head"
          rel="preload"
          as="image"
          href={heroInitialHref}
          fetchpriority="high"
        />
      )}
      {heroBg && heroInitialHref && (
        <HomeHero sources={heroBg} initialHref={heroInitialHref} />
      )}
    </Layout>
  )
}
