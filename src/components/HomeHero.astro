---
import ResponsiveDichromPicture from './ResponsiveDichromPicture.astro';
import type { DichromHeroResponsiveSet } from '../constants/dichrom-responsive';
import {
  HERO_BG_BITMAP_HEIGHT,
  HERO_BG_BITMAP_WIDTH,
} from '../constants/hero-layout';
import { dichromHeroEarlyInlineScript } from '../utils/bundle-dichrom-hero-early';
import '../styles/pages/hero.css';

interface Props {
  sources: DichromHeroResponsiveSet;
  initialHref: string;
}

const { sources: heroBg, initialHref }: Props = Astro.props;
const heroSrcScript = dichromHeroEarlyInlineScript();
---

<nav class="hero-header" aria-label="Main navigation">
  <div class="hero-header__inner">
    <a href="/profile" class="site-header__item site-nav__link">Profile</a>
    <a href="/writing" class="site-header__item site-nav__link">Writing</a>
    <a href="/contact" class="site-header__item site-nav__link">Contact</a>
  </div>
</nav>
<article class="content-panel-page">
  <h1 class="page-title">Jan Havlín</h1>
  <section class="hero content-panel">
    <figure class="hero-figure" aria-hidden="true">
      <ResponsiveDichromPicture
        sources={heroBg}
        width={HERO_BG_BITMAP_WIDTH}
        height={HERO_BG_BITMAP_HEIGHT}
        alt="Hero background"
        class="hero-bg__image"
        fetchpriority="high"
        initialHref={initialHref}
      />
      <script is:inline set:html={heroSrcScript} />
    </figure>

    <div class="hero-content">
      <p class="tagline tagline--sub">As I build software systems…</p>
      <p class="tagline">Making sense of<br />the craft</p>
    </div>
  </section>
</article>
<script is:inline>
  (function () {
    'use strict';

    const SEL = {
      hero: '.hero',
      heroBgImage: '.hero-bg__image',
    };

    function revealHeroWhenImageReady() {
      const hero = document.querySelector(SEL.hero);
      const heroImg = document.querySelector(SEL.heroBgImage);
      if (!(hero instanceof HTMLElement)) return;
      if (!(heroImg instanceof HTMLImageElement)) {
        hero.classList.add('hero--ready');
        return;
      }

      const reveal = () => hero.classList.add('hero--ready');
      if (heroImg.complete && heroImg.naturalWidth > 0) {
        reveal();
        return;
      }
      heroImg.addEventListener('load', reveal, { once: true });
      heroImg.addEventListener('error', reveal, { once: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', revealHeroWhenImageReady, {
        once: true,
      });
    } else {
      revealHeroWhenImageReady();
    }
  })();
</script>
<script>
  import { initHeroTaglineWidthFit } from '../scripts/hero-tagline-width-fit.ts';
  initHeroTaglineWidthFit();
</script>
