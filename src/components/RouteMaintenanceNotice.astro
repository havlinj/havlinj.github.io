---
import PanelFilmGrain from './PanelFilmGrain.astro';
import {
  MAINTENANCE_PANEL_PHOTO,
  MAINTENANCE_PANEL_PHOTO_SIZES,
  MAINTENANCE_PANEL_PHOTO_SRCSET,
  MAINTENANCE_RETURN_LINE,
} from '../constants/maintenance-panel';
import type { MaintenanceDecision } from '../utils/maintenance';
import '../styles/pages/maintenance.css';

interface Props {
  decision: Extract<MaintenanceDecision, { kind: 'route' }>;
}

const { decision }: Props = Astro.props;
const routeLabel = decision.displayPath;
const headlineTail = 'is under maintenance';
---

<article class="route-maintenance-page content-panel-page">
  <h1 class="page-title">Whoops</h1>
  <div class="page-buttons-zone">
    <div class="page-buttons-panel route-maintenance-panel content-panel">
      <div
        class="page-buttons-panel__media route-maintenance-panel__media--pending"
        aria-hidden="true"
      >
        <picture>
          <img
            src={MAINTENANCE_PANEL_PHOTO.src}
            srcset={MAINTENANCE_PANEL_PHOTO_SRCSET}
            sizes={MAINTENANCE_PANEL_PHOTO_SIZES}
            width={MAINTENANCE_PANEL_PHOTO.width}
            height={MAINTENANCE_PANEL_PHOTO.height}
            alt=""
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <PanelFilmGrain filterId="route-maintenance-panel-grain" />
      </div>
      <div class="route-maintenance-panel__copy">
        <p class="route-maintenance-panel__headline">
          <span class="route-maintenance-panel__headline-lead">
            Page <span class="route-maintenance-panel__route">{routeLabel}</span
            >
          </span>
          <span class="route-maintenance-panel__headline-tail"
            >{headlineTail}</span
          >
        </p>
        <div class="route-maintenance-panel__info">
          <p>{MAINTENANCE_RETURN_LINE}</p>
        </div>
      </div>
    </div>
  </div>
</article>

<noscript>
  <style>
    .route-maintenance-page
      .page-buttons-panel__media.route-maintenance-panel__media--pending {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  import '../scripts/maintenance-panel-edge.ts';
</script>
