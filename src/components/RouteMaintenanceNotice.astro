---
import ResponsiveDichromPicture from './ResponsiveDichromPicture.astro';
import { buildDichromResponsive } from '../constants/dichrom-responsive';
import { MAINTENANCE_PANEL_BG_STEM } from '../constants/maintenance-panel';
import {
  formatMaintenanceStartedDate,
  type MaintenanceDecision,
} from '../utils/maintenance';
import '../styles/pages/maintenance.css';

interface Props {
  decision: Extract<MaintenanceDecision, { kind: 'route' }>;
}

const { decision }: Props = Astro.props;
const startedLabel = formatMaintenanceStartedDate(decision.started);
const routeLabel = decision.displayPath;
const headlineTail = 'is under maintenance.';

const maintenanceBg = buildDichromResponsive(MAINTENANCE_PANEL_BG_STEM);
---

<article class="route-maintenance-page">
  <h1 class="page-title">Whoops</h1>
  <div class="page-buttons-zone">
    <div class="page-buttons-panel route-maintenance-panel">
      <div class="page-buttons-panel__media" aria-hidden="true">
        <ResponsiveDichromPicture
          sources={maintenanceBg}
          width={2736}
          height={2736}
          fetchpriority="high"
        />
      </div>
      <div class="route-maintenance-panel__copy">
        <p class="route-maintenance-panel__headline">
          <span class="route-maintenance-panel__headline-lead">
            Page <span class="route-maintenance-panel__route">{routeLabel}</span
            >
          </span>
          <span class="route-maintenance-panel__headline-tail"
            >{headlineTail}</span
          >
        </p>
        <div class="route-maintenance-panel__info">
          <p class="route-maintenance-panel__date">
            Started on {startedLabel}
          </p>
          <p>Content will return soon.</p>
        </div>
      </div>
    </div>
  </div>
</article>
