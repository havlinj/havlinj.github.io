---
import {
  RECONSTRUCTION_HEADLINE_TAIL,
  RECONSTRUCTION_PANEL_PHOTO,
  RECONSTRUCTION_PANEL_PHOTO_SIZES,
  RECONSTRUCTION_PANEL_PHOTO_SRCSET,
  RECONSTRUCTION_RETURN_LINE,
} from '../constants/maintenance-panel';
import { LAYOUT_NAV_ITEMS } from '../layouts/layout-nav';
import '../styles/pages/maintenance.css';
---

<div class="site-header site-header--reserved" aria-hidden="true">
  <div class="site-header__inner">
    {
      LAYOUT_NAV_ITEMS.map((item) => (
        <span class="site-header__item">{item.label}</span>
      ))
    }
  </div>
</div>
<article class="reconstruction-page content-panel-page">
  <h1 class="page-title reconstruction-page__title" aria-hidden="true">
    &nbsp;
  </h1>
  <div class="page-buttons-zone">
    <div class="page-buttons-panel reconstruction-panel content-panel">
      <div
        class="page-buttons-panel__media reconstruction-panel__media--pending"
        aria-hidden="true"
      >
        <picture>
          <img
            src={RECONSTRUCTION_PANEL_PHOTO.src}
            srcset={RECONSTRUCTION_PANEL_PHOTO_SRCSET}
            sizes={RECONSTRUCTION_PANEL_PHOTO_SIZES}
            width={RECONSTRUCTION_PANEL_PHOTO.width}
            height={RECONSTRUCTION_PANEL_PHOTO.height}
            alt=""
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
      <div class="reconstruction-panel__copy">
        <h1 class="reconstruction-panel__headline">
          <span class="reconstruction-panel__headline-lead">The website</span>
          <span class="reconstruction-panel__headline-tail">
            {RECONSTRUCTION_HEADLINE_TAIL}
          </span>
        </h1>
        <div class="reconstruction-panel__info">
          <p>{RECONSTRUCTION_RETURN_LINE}</p>
        </div>
      </div>
    </div>
  </div>
</article>

<noscript>
  <style>
    .reconstruction-page
      .page-buttons-panel__media.reconstruction-panel__media--pending {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  import '../scripts/maintenance-panel-edge.ts';
</script>
