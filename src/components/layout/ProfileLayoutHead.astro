---
import interLatin700Woff2 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import { dichromTileMobileSrcset } from '../../constants/dichrom-responsive';
import {
  PROFILE_DICHROM_TILE_SIZES,
  PROFILE_FOUNDATIONS_BG,
  PROFILE_PORTRAIT_BG,
  PROFILE_WHAT_I_DO_FALLBACK_HREF,
  PROFILE_WHY_BG,
} from '../../constants/profile-layout';

const { profileStylesUrl } = Astro.props as { profileStylesUrl: string };
---

{
  /* Profile grid must stay invisible until portrait + type-fit. The hide rule
     lives in profile.css (applied early via head-append script). Without this
     head snippet, page-button min/max-height paints thin outlines first.
     Panel height needs no reservation here: `.content-panel` ships in the
     render-blocking Layout bundle, so the square is sized on first paint. */
}
<style is:inline>
  .profile-section--loading {
    opacity: 0 !important;
    visibility: hidden !important;
  }
  .profile-section--loading .page-button.prof-tile {
    max-height: none !important;
    min-height: 0 !important;
  }
</style>
<link rel="preload" href={profileStylesUrl} as="style" />
<link
  rel="preload"
  href={interLatin700Woff2}
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  as="image"
  href={PROFILE_PORTRAIT_BG.w160.href}
  imagesrcset={dichromTileMobileSrcset(PROFILE_PORTRAIT_BG)}
  imagesizes={PROFILE_DICHROM_TILE_SIZES}
  fetchpriority="high"
/>
<link
  rel="preload"
  as="image"
  href={PROFILE_WHY_BG.w160.href}
  imagesrcset={dichromTileMobileSrcset(PROFILE_WHY_BG)}
  imagesizes={PROFILE_DICHROM_TILE_SIZES}
/>
<link
  rel="preload"
  as="image"
  href={PROFILE_FOUNDATIONS_BG.w160.href}
  imagesrcset={dichromTileMobileSrcset(PROFILE_FOUNDATIONS_BG)}
  imagesizes={PROFILE_DICHROM_TILE_SIZES}
/>
<link rel="preload" as="image" href={PROFILE_WHAT_I_DO_FALLBACK_HREF} />
