---
import {
  LAYOUT_NAV_ITEMS,
  type LayoutNavSection,
} from '../../layouts/layout-nav';

const { activeSection, reserved = false } = Astro.props as {
  activeSection?: LayoutNavSection | string;
  reserved?: boolean;
};
---

<header
  class:list={['site-header', reserved && 'site-header--reserved']}
  aria-hidden={reserved ? 'true' : undefined}
>
  {
    /* No Home link: hero is welcome-only; main destinations are Profile / Writing / Contact. */
  }
  <div class="site-header__inner">
    {
      reserved
        ? LAYOUT_NAV_ITEMS.map((item) => (
            <span class="site-header__item">{item.label}</span>
          ))
        : LAYOUT_NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class={
                'site-header__item site-nav__link' +
                (activeSection === item.section
                  ? ' site-nav__link--active'
                  : '')
              }
            >
              {item.label}
            </a>
          ))
    }
  </div>
</header>
