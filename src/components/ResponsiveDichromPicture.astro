---
import {
  dichromCandidateSrcset,
  type DichromResponsiveSet,
} from '../constants/dichrom-responsive';

interface Props {
  sources: DichromResponsiveSet;
  width: number;
  height: number;
  alt?: string;
  class?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  /**
   * One URL in the document, no srcset. The hero measurement script may
   * replace it after layout.
   */
  initialHref?: string;
}

const {
  sources,
  width,
  height,
  alt = '',
  class: className,
  fetchpriority,
  decoding = 'async',
  initialHref,
}: Props = Astro.props;
const singleSrc = Boolean(initialHref);
const fallbackHref = initialHref ?? sources.w1440.href;
---

<picture>
  <img
    src={singleSrc ? initialHref : undefined}
    data-dichrom-candidates={dichromCandidateSrcset(sources)}
    data-dichrom-fallback={fallbackHref}
    width={width}
    height={height}
    alt={alt}
    class={className}
    decoding={decoding}
    fetchpriority={fetchpriority}
  />
</picture>
{
  !singleSrc && (
    <noscript>
      <img src={fallbackHref} alt={alt} />
    </noscript>
  )
}
