---
import {
  dichromCandidateSrcset,
  dichromDesktopSrcset,
  dichromMobileSrcset,
  type DichromResponsiveSet,
} from '../constants/dichrom-responsive';

interface Props {
  sources: DichromResponsiveSet;
  width: number;
  height: number;
  alt?: string;
  class?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  sizes?: string;
  /** Matches content panel pages: mobile `<source>` breakpoint. */
  mobileMedia?: string;
  /**
   * One URL in the document, no srcset. The hero measurement script may
   * replace it after layout.
   */
  initialHref?: string;
}

const {
  sources,
  width,
  height,
  alt = '',
  class: className,
  fetchpriority,
  decoding = 'async',
  sizes = '100vw',
  mobileMedia = '(max-width: 767px)',
  initialHref,
}: Props = Astro.props;
const singleSrc = Boolean(initialHref);
---

<picture>
  {
    !singleSrc && (
      <source
        media={mobileMedia}
        srcset={dichromMobileSrcset(sources)}
        sizes={sizes}
      />
    )
  }
  <img
    src={initialHref ?? sources.w1440.href}
    srcset={singleSrc ? undefined : dichromDesktopSrcset(sources)}
    sizes={singleSrc ? undefined : sizes}
    data-dichrom-candidates={dichromCandidateSrcset(sources)}
    data-dichrom-fallback={singleSrc ? initialHref : undefined}
    width={width}
    height={height}
    alt={alt}
    class={className}
    decoding={decoding}
    fetchpriority={fetchpriority}
  />
</picture>
